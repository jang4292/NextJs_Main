# --- SMTP (contact form) ---
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-app-password
RECEIVER_EMAIL=you@example.com

# --- Admin auth ---
ADMIN_USERNAME=admin
# Generate with: node -e "require('bcryptjs').hash('your-real-password', 10).then(console.log)"
# IMPORTANT: Next.js expands $VAR references in .env files, and bcrypt hashes are
# full of literal `$` characters. Escape every `$` as `\$` below or the hash will be
# silently corrupted (login will just always fail with no error explaining why).
ADMIN_PASSWORD_HASH=\$2b\$10\$replace-with-generated-bcrypt-hash
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-byte-random-base64-string

# --- Music / DJ Play List audio source ---
# Base URL for hosted audio files (S3 bucket or CDN). Falls back to the
# original demo bucket if unset. Exposed to the client, so no secrets here.
NEXT_PUBLIC_AUDIO_BASE_URL=https://audiofilestudy.s3.ap-northeast-2.amazonaws.com

# --- Media Downloader local tooling ---
# Used only by /tools/media-downloader in local Node.js runtime.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_ANALYZE_TIMEOUT_MS=45000
MEDIA_DOWNLOAD_TIMEOUT_MS=180000
MEDIA_MAX_OUTPUT_BYTES=367001600
